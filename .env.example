# rename file to .env.local

## PostHog
PUBLIC_POSTHOG_PROJECT_TOKEN='your_posthog_project_token_here'
PUBLIC_POSTHOG_HOST='https://your-posthog-host'

## Google Auth
GOOGLE_CLIENT_ID=''
GOOGLE_CLIENT_SECRET=''
REDIRECT_URI=''

## Google device flow, used by /login/device for browsers google refuses.
## Must be an OAuth client of type "TVs and Limited Input devices"; a web client will not
## work. No redirect URI applies to that client type.
GOOGLE_DEVICE_CLIENT_ID=''
GOOGLE_DEVICE_CLIENT_SECRET=''

## TURSO
TURSO_CONNECTION_URL=''
TURSO_AUTH_TOKEN=''
