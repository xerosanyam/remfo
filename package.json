{
	"name": "remfo",
	"version": "0.0.1",
	"private": true,
	"browserslist": [
		"defaults",
		"Safari 6"
	],
	"scripts": {
		"dev": "vite dev",
		"build": "bun run test && vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:ui": "vitest --ui",
		"test:watch": "vitest",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"generate": "npx drizzle-kit generate",
		"migrate": "npx drizzle-kit migrate",
		"perf": "node scripts/perf.mjs",
		"test:nojs": "node scripts/nojs.mjs"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@iconify/json": "^2.2.230",
		"@libsql/client": "0.18.0",
		"@lucia-auth/adapter-sqlite": "3.0.2",
		"@sveltejs/adapter-vercel": "6.3.4",
		"@sveltejs/enhanced-img": "^0.11.0",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "6.2.4",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.2.0",
		"@typescript-eslint/eslint-plugin": "8.69.0",
		"@typescript-eslint/parser": "8.69.0",
		"@vercel/analytics": "2.0.1",
		"@vite-pwa/sveltekit": "1.1.0",
		"@vitest/ui": "5.0.0",
		"arctic": "1.9.2",
		"autoprefixer": "10.5.4",
		"cal-heatmap": "^4.2.4",
		"date-fns": "4.4.0",
		"dotenv": "17.4.2",
		"drizzle-kit": "0.31.10",
		"drizzle-orm": "0.45.2",
		"eslint": "10.9.1",
		"eslint-config-prettier": "9.1.0",
		"eslint-plugin-svelte": "3.23.0",
		"globals": "17.12.0",
		"happy-dom": "^20.13.2",
		"lighthouse": "^13.4.1",
		"lucia": "3.2.2",
		"msw": "2.15.0",
		"openai": "7.9.0",
		"postcss": "8.5.27",
		"posthog-js": "^1.148.2",
		"prettier": "3.9.6",
		"prettier-plugin-svelte": "3.2.6",
		"prettier-plugin-tailwindcss": "0.8.1",
		"svelte": "5.57.0",
		"svelte-check": "4.7.6",
		"sveltekit-device-detector": "2.0.1",
		"sveltekit-superforms": "2.30.2",
		"tailwindcss": "3.4.6",
		"typescript": "6.0.3",
		"unplugin-icons": "23.0.1",
		"vite": "7.3.6",
		"vite-plugin-pwa": "1.3.0",
		"vitest": "5.0.0",
		"zod": "3.25.76"
	},
	"overrides": {
		"zod": "3.25.76",
		"form-data": "4.0.6"
	},
	"type": "module",
	"msw": {
		"workerDirectory": [
			"static"
		]
	}
}
